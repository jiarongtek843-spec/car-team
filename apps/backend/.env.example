PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_team_dev"
# 支持逗号分隔多个 origin，例如同时允许 Railway staging frontend 跟本地测试：
# CORS_ORIGIN="https://frontend-staging-xxxx.up.railway.app,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
SESSION_SECRET="change-me-to-a-random-string"

# 本地开发留空/不设定即可。部署到 Railway 等真实服务器（HTTPS）时设成 "production"——
# 只影响 Cookie 的 Secure/SameSite 行为，不代表这是正式营运环境，见下面的 APP_ENV。
# NODE_ENV="production"

# 独立于 NODE_ENV 之外的开关，只用来决定「这个环境可不可以写入测试/种子资料」：
# "development"（本地，默认）/ "staging"（Railway 内部测试环境）/ "production"（正式环境，
# 一旦设成这个值，npm run db:seed 会直接拒绝执行）。
# APP_ENV="staging"

# 只有跑 npm run db:seed 时会用到；不设定就沿用本地开发的固定密码。Staging/Production
# 一定要设成专属密码，不能沿用本地开发密码，也不能 commit 进 git。
# SEED_PASSWORD="change-me-to-a-strong-staging-only-password"
