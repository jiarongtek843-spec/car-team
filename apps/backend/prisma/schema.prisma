generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Mobile UX + Scheduling Sprint（2026-07）：区分「去程/回程/额外行程」，让 Booking 表单
// 能预设建立去程+回程两个 Leg，Dispatch/Driver Job 也能清楚标示这是哪一段。纯标签用途，
// 不影响任何既有的状态机或财务计算逻辑。
enum LegType {
  OUTBOUND
  RETURN
  ADDITIONAL
}

// Leg 的完整状态机，见 docs/modules/driver-account.md
enum LegStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  DRIVER_ARRIVING
  PASSENGER_ON_BOARD
  COMPLETED
  REJECTED
  CANCELLED
}

// Phase 1 Dispatch Engine（docs/design/phase2-gps-dispatch-architecture.md §3.3，2026-07 简化版）：
// 刻意没有「Wave/Round」的概念——Dispatcher 按一次「Send Offer」，合格的 Driver 会同时收到
// Offer，不是分批送。第一个 Accept 的赢，其他 PENDING 的 Offer 立刻关闭；逾时没人 Accept
// 就整批变 EXPIRED，Leg 留在既有的 Waiting Bookings 名单，交回 Dispatcher 手动处理或再送一次——
// 不会自动重试第二轮。
enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  // Driver 主动拒绝
  DECLINED
  // 逾时没回应，或者另一个 Offer 先被 Accept 而被自动关闭——两种情况都算「这个 Offer 结束了、
  // 不会变成 Assigned」，刻意不拆成两个状态，Dispatcher board 只需要知道「不是 Accepted」。
  EXPIRED
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WalletTransactionType {
  LEG_EARNING
  MANUAL_ADJUSTMENT
  SETTLEMENT_ADJUSTMENT
  // Module 9：Trip Expense 的 paidBy=DRIVER 且 reimbursementRequired=true 时产生。
  EXPENSE_REIMBURSEMENT
  // Module 12（Wallet Migration）：Financial V2 Booking 专用，Revenue Sharing Issue Wallet
  // 时按 Leg 的 earningAllocationCents 比例分配 Snapshot.driverPoolCents 产生。V1 Booking
  // 永远不会有这个类型，继续用 LEG_EARNING——同一张 Booking 不会同时出现两者。
  REVENUE_SHARE_PAYOUT
}

// Module 9：钱的源头分类，独立于 WalletTransactionType 之外，给 Money Reference Trace 用。
enum WalletTransactionSource {
  BOOKING_REVENUE
  TRIP_EXPENSE
  MANUAL
  SETTLEMENT_CORRECTION
}

enum WalletTransactionStatus {
  PENDING
  SETTLED
  VOIDED
}

enum SettlementStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum CollectionPaymentMethod {
  CASH
  TRANSFER_TO_DRIVER
  TRANSFER_TO_COMPANY
  TNG
  OTHER
}

enum CollectionPurpose {
  ITEM_PURCHASE
  DELIVERY_FEE
  PARCEL
  EXTRA_CHARGE
  PARKING
  TOLL
  OTHER
}

// Collection 是独立于 Wallet 的第二本 Ledger：代表 Driver 暂时替公司保管的钱
// (公司应收，不是 Driver 收入)。PENDING 保留给未来「Admin 指派代收任务」的流程，
// 目前 Driver 新增时直接是 COLLECTED（代表钱已经实际收到手上）。
enum CollectionStatus {
  PENDING
  COLLECTED
  VERIFIED
  SETTLED
  VOIDED
}

// Module 13（Collection Ledger Schema）：谁实际持有这笔钱，跟 CollectionPaymentMethod（怎么付）
// 是刻意分开的两个维度，见 docs/design/collection-module-v1.md 第 7/8 章。第一版只支持
// DRIVER/COMPANY，THIRD_PARTY 留待真正有第三方代收需求时再启用（加值不需要重新设计栏位）。
enum CollectedBy {
  DRIVER
  COMPANY
}

// collectedBy 回答「谁的角色收的」，receiverType 回答「receiverId 指向哪一种实体」——v1 两者
// 取值刚好一一对应（用 DB CHECK constraint 保证不会不小心兜不起来，见 migration.sql），
// 分成两个栏位是为了未来两者有可能分歧时不需要再动一次 Schema。
enum CollectionReceiverType {
  DRIVER
  COMPANY
}

// Module 9（Financial Model v2）：Booking 的财务状态，跟营运面 BookingStatus 并行，
// 同样是派生值，不能手动设定。见 docs/design/financial-model-v2.md 第 3 章。
enum BookingFinancialStatus {
  OPEN
  ACCRUING
  FINALIZED
  VOIDED
}

// Module 12（Wallet Migration）：Migration Cut-over 标记，见 model Booking 的
// financialVersion 栏位注解跟 docs/modules/wallet-migration.md。
enum FinancialVersion {
  V1
  V2
}

// BookingCharge 的更正标记：原始记录是 NONE；补收新增一笔 ADDITION；冲销新增一笔 REVERSAL。
// 两者都要靠 adjustsChargeId 指回原始 Charge——DB 层用 CHECK constraint 保证这个搭配合法
// （见 migration.sql，Prisma schema 语法本身不支援任意 CHECK constraint）。
enum ChargeAdjustmentType {
  NONE
  ADDITION
  REVERSAL
}

enum TripExpenseType {
  TOLL
  PARKING
  FUEL
  OTHER
}

enum TripExpensePaidBy {
  COMPANY
  DRIVER
}

enum TripExpenseStatus {
  PENDING
  VERIFIED
  REJECTED
  REIMBURSED
  VOIDED
}

// BOOKING_FINALIZED：Owner/Manager 手动呼叫 Finalize API。LEG_COMPLETED（2026-07 新增，
// Driver Earnings Auto-Trigger Bug Fix）：V2 Booking 的第一条 Leg 完成时，由
// driverJobs.completeLeg 自动建立——取代原本「没有任何 UI 会呼叫 Finalize，所有 V2
// Booking 的司机收入永远不会产生」的死路。两者只差在触发来源，Snapshot 本身的计算逻辑
// 完全相同。见 docs/modules/wallet-migration.md。
enum RevenueSnapshotTrigger {
  BOOKING_FINALIZED
  LEG_COMPLETED
}

// RBAC（Module 7）：Role 存数据库，Permission Key 固定写在
// apps/backend/src/common/permissions.ts。以后新增角色（例如 Finance）只需要新增一笔
// Role 资料 + 对应的 RolePermission，不需要改任何业务逻辑代码——业务 service/controller
// 从来不会判断 role，权限检查完全集中在 requirePermission middleware 这一层。
model Role {
  id          Int      @id @default(autoincrement())
  // 机器可读、稳定不变的代号，程式码里用这个比对（例如判断是不是 Driver 角色）。
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// permissionKey 不是外键，对应的是 permissions.ts 里 PERMISSIONS 常数定义的字串
// （例如 "wallet:write"）——Permission 本身不是一个需要在 DB 里维护的实体，只有
// 「哪个角色拥有哪些 Permission」这个对应关系是资料。
model RolePermission {
  id            Int      @id @default(autoincrement())
  roleId        Int      @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

// 登入帐号，四种角色共用同一套。Driver 角色的业务资料在 Driver model，
// 两者用 userId 关联；非 Driver 角色没有对应的 Driver row。
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  driver       Driver?
  auditLogs    AuditLog[]

  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  settlementsCreated        Settlement[]        @relation("SettlementCreatedBy")
  settlementsVoided         Settlement[]        @relation("SettlementVoidedBy")

  collectionsCreated  Collection[] @relation("CollectionCreatedBy")
  collectionsVerified Collection[] @relation("CollectionVerifiedBy")
  collectionsVoided   Collection[] @relation("CollectionVoidedBy")

  bookingChargesCreated BookingCharge[] @relation("BookingChargeCreatedBy")

  tripExpensesCreated  TripExpense[] @relation("TripExpenseCreatedBy")
  tripExpensesVerified TripExpense[] @relation("TripExpenseVerifiedBy")
  tripExpensesRejected TripExpense[] @relation("TripExpenseRejectedBy")
  tripExpensesVoided   TripExpense[] @relation("TripExpenseVoidedBy")

  @@map("users")
}

// 司机业务资料。userId 关联登入帐号；status 同时也是「是否停用」的唯一依据
// （沿用 Module 1 就有的栏位，没有另外加一个重复的启用/停用状态）。
model Driver {
  id                 Int          @id @default(autoincrement())
  userId             Int?         @unique @map("user_id")
  user               User?        @relation(fields: [userId], references: [id])
  name               String
  phone              String?
  vehiclePlateNumber String?      @map("vehicle_plate_number")
  remark             String?
  status             DriverStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  legs               Leg[]

  walletTransactions WalletTransaction[]
  settlements        Settlement[]
  collections        Collection[]
  dispatchOffers     DispatchOffer[]

  // GPS 上线状态。isOnline 是 Driver 自己按 Go Online/Go Offline 设的旗标；实际显示给 Admin 的
  // presence（是否 Connection Lost / 自动 Offline）由 gps.service.ts 依据 DriverLocation 的
  // 最后上传时间即时算出，不是只看这个栏位——见 docs/modules/gps.md。
  isOnline    Boolean         @default(false) @map("is_online")
  onlineSince DateTime?       @map("online_since")
  location    DriverLocation?

  @@map("drivers")
}

// 只存「最新一笔」定位，不做轨迹历史（第一版明确不需要轨迹回放）。每次上传直接覆盖。
// recordedAt 是装置端上报的时间，receivedAt 是 Backend 收到的时间——heartbeat/自动离线判断
// 一律用 receivedAt，避免装置时间不准影响判断。
model DriverLocation {
  driverId       Int      @id @map("driver_id")
  driver         Driver   @relation(fields: [driverId], references: [id])
  latitude       Float
  longitude      Float
  speed          Float?
  heading        Float?
  batteryPercent Int?     @map("battery_percent")
  recordedAt     DateTime @map("recorded_at")
  receivedAt     DateTime @updatedAt @map("received_at")

  @@map("driver_locations")
}

// 单例设定表，只会有一笔（id=1）。Module 8 起，所有系统模块的可调参数（GPS 阈值、
// Collection 上传大小上限、Booking 默认抽成…）统一从这里读，不要把数值写死在程式码里。
model CompanySettings {
  id Int @id @default(autoincrement())

  // General
  companyName String @default("") @map("company_name")
  timezone    String @default("Asia/Kuala_Lumpur") @map("timezone")
  currency    String @default("RM") @map("currency")

  // Booking（defaultCommissionType/Value 是 Module 3 就有的既有栏位，Booking 建立时读这里当默认抽成）
  defaultCommissionType    CommissionType @default(PERCENTAGE) @map("default_commission_type")
  // PERCENTAGE 时是整数百分比（15 = 15%）；FIXED_AMOUNT 时是 cents。
  defaultCommissionValue   Int            @default(15) @map("default_commission_value")
  // 目前只存资料、不影响实际行为（业务逻辑本来就一直是「允许手动分配」/「一定要 Driver Accept」），
  // 保留给未来真的要做成可切换行为时使用，见 docs/modules/company-settings.md 已知限制。
  allowManualLegAllocation Boolean        @default(true) @map("allow_manual_leg_allocation")
  requireDriverAccept      Boolean        @default(true) @map("require_driver_accept")

  // GPS（gps.service.ts 的 presence 阈值、前端上传间隔，全部从这里读，不再写死常数）
  gpsUploadIntervalSeconds     Int @default(5) @map("gps_upload_interval_seconds")
  connectionLostTimeoutSeconds Int @default(30) @map("connection_lost_timeout_seconds")
  offlineTimeoutSeconds        Int @default(120) @map("offline_timeout_seconds")

  // Phase 1 Dispatch Engine（docs/design/phase2-gps-dispatch-architecture.md §3.5，简化版）：
  // 一个全局数字，不是 per-policy 的设定——DispatchPolicy 那一整套是 Future Extension，
  // Phase 1 刻意只留这一个可调参数。
  dispatchOfferTimeoutSeconds Int @default(30) @map("dispatch_offer_timeout_seconds")

  // Settlement（目前没有任何排程会真的用到这两个栏位——现在的 Daily Settlement 是手动触发，
  // 这两个栏位是给未来「自动排程结算」预留的设定，见已知限制）
  defaultSettlementTime String @default("21:00") @map("default_settlement_time")
  settlementTimezone    String @default("Asia/Kuala_Lumpur") @map("settlement_timezone")

  // Collection（maxUploadFileSizeMb 真的会拿去限制上传大小；collectionVerificationRequired
  // 目前只存资料，业务逻辑本来就一直要求 Verified 才能结算，见已知限制）
  collectionVerificationRequired Boolean @default(true) @map("collection_verification_required")
  maxUploadFileSizeMb            Int     @default(5) @map("max_upload_file_size_mb")

  // Revenue Sharing（Module 11）：只对参与 Revenue Sharing 的 Charge（chargeType.
  // participatesInRevenueSharing=true）的加总生效，Company/Dispatcher Commission 各自
  // 独立算，互不影响，两者加总不能超过参与计算的总额（由 revenueSharing.calculator.ts
  // 检查）。Driver Pool 没有独立栏位——定义上就是参与计算的总额扣掉两笔 Commission 后
  // 的余额，见 docs/modules/revenue-sharing-api.md。未来如果要新增第三种 Commission
  // （例如 Referral Commission），比照这两栏位的模式各加两个栏位即可，不需要改动
  // Revenue Sharing 的计算/验证/Snapshot 逻辑本身。
  companyCommissionType     CommissionType @default(PERCENTAGE) @map("company_commission_type")
  companyCommissionValue    Int            @default(15) @map("company_commission_value")
  dispatcherCommissionType  CommissionType @default(PERCENTAGE) @map("dispatcher_commission_type")
  dispatcherCommissionValue Int            @default(0) @map("dispatcher_commission_value")

  // Module 12（Wallet Migration）：Finalize 现在会自动发放 Wallet（不再有独立的 Issue
  // Wallet 手动步骤），所以「谁能执行 Finalize」变成一个够敏感、需要能配置的决定——
  // 不写死在 Permission 里，而是放这里当运行时开关。OWNER 永远可以 Finalize，不受这个
  // 栏位影响；MANAGER 即使在 RBAC 层拥有 revenueSharing:finalize，也要这个栏位是 true
  // 才真的放行（默认 false = 第一版维持只有 OWNER）。见 docs/modules/wallet-migration.md。
  allowManagerFinalizeRevenueSharing Boolean @default(false) @map("allow_manager_finalize_revenue_sharing")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model Booking {
  id       Int     @id @default(autoincrement())
  girlName String  @map("girl_name")
  notes    String?

  // Booking 总价与抽成。建立时从 CompanySettings 复制默认值，之后可单独覆盖这张 Booking，
  // 不影响全公司设定。platformAmountCents / driverPoolAmountCents 一律由 Backend 算出，
  // 不接受前端直接传入。
  totalAmountCents        Int            @default(0) @map("total_amount_cents")
  platformCommissionType  CommissionType @default(PERCENTAGE) @map("platform_commission_type")
  platformCommissionValue Int            @default(15) @map("platform_commission_value")
  platformAmountCents     Int            @default(0) @map("platform_amount_cents")
  driverPoolAmountCents   Int            @default(0) @map("driver_pool_amount_cents")

  // Module 9 起，以上四个金额栏位改为「快取的计算结果」：totalAmountCents = SUM(BookingCharge)，
  // platformAmountCents/driverPoolAmountCents 来自 Revenue Sharing 即时计算，不再接受 API
  // 直接写入。栏位本身保留不删，避免 Breaking Migration（见 docs/design/database-schema-v2.md）。
  financialStatus BookingFinancialStatus @default(OPEN) @map("financial_status")

  // Module 12（Wallet Migration）：Migration Cut-over 标记，每张 Booking 一辈子只属于一个
  // Financial Version，禁止混用两套收入模型。V1（这次 migration 之前建立的既有 Booking，
  // 已经透过 migration 回填）继续用 Leg 完成 -> LEG_EARNING 那一套旧机制；V2（这次
  // migration 之后新建立的 Booking，DB 层默认值就是 V2）完全不建立 LEG_EARNING，
  // 收入改由 Revenue Sharing Finalize + Issue Wallet 统一处理。见 docs/modules/wallet-migration.md。
  financialVersion FinancialVersion @default(V2) @map("financial_version")

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  legs      Leg[]

  walletTransactions WalletTransaction[]
  collections        Collection[]
  charges            BookingCharge[]
  tripExpenses       TripExpense[]
  revenueSnapshot    RevenueSharingSnapshot?

  @@index([financialStatus])
  @@index([financialVersion])
  @@map("bookings")
}

model Leg {
  id              Int       @id @default(autoincrement())
  bookingId       Int       @map("booking_id")
  booking         Booking   @relation(fields: [bookingId], references: [id])
  sequence        Int
  legType         LegType   @default(ADDITIONAL) @map("leg_type")
  driverId        Int?      @map("driver_id")
  driver          Driver?   @relation(fields: [driverId], references: [id])
  pickupLocation  String?   @map("pickup_location")
  dropoffLocation String?   @map("dropoff_location")
  scheduledAt     DateTime? @map("scheduled_at")
  notes           String?
  status          LegStatus @default(PENDING)

  // Mobile UAT Round 2：scheduledAt 就是 Pickup Time，这两个是额外补充的排程栏位，
  // 各自独立存，互不派生（estimatedFinishAt 不是 scheduledAt+estimatedDurationMinutes
  // 算出来存的，前端预设会自动算好填入，但 Admin 手动改过之后就照 Admin 填的存，
  // 不会被后续的 Duration/Pickup Time 编辑悄悄覆盖回去）。
  estimatedDurationMinutes Int?      @map("estimated_duration_minutes")
  estimatedFinishAt        DateTime? @map("estimated_finish_at")

  // 这个 Leg 完成后司机应得多少钱。Mobile UAT Round 2 之后预设由 Driver Pool 按未取消
  // Leg 数量自动平分（见 legs.service.ts 的 redistributeAutoAllocations），
  // earningAllocationManual=true 代表 Admin 明确手动改过这笔的金额，之后的自动平分
  // 不会再动它，只会拿剩余的 Pool 在其他仍是自动模式的 Leg 之间平分。
  earningAllocationCents  Int?    @map("earning_allocation_cents")
  earningAllocationManual Boolean @default(false) @map("earning_allocation_manual")

  rejectionReason    String?   @map("rejection_reason")
  assignedAt         DateTime? @map("assigned_at")
  acceptedAt         DateTime? @map("accepted_at")
  driverArrivingAt   DateTime? @map("driver_arriving_at")
  passengerOnBoardAt DateTime? @map("passenger_on_board_at")
  completedAt        DateTime? @map("completed_at")
  rejectedAt         DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  walletTransactions WalletTransaction[]
  collections        Collection[]
  bookingCharges     BookingCharge[]
  tripExpenses       TripExpense[]
  dispatchOffers     DispatchOffer[]

  @@unique([bookingId, sequence])
  @@map("legs")
}

// Phase 1 Dispatch Engine 的 Offer 记录。一次「Send Offer」= 同一个 legId 底下、同一个
// offeredAt 附近，给每个合格 Driver 各建一笔（没有 round/policyId 这些栏位——那些是 Future
// Extension，见设计文件 §3.8，Phase 1 不做）。
model DispatchOffer {
  id         Int                 @id @default(autoincrement())
  legId      Int                 @map("leg_id")
  leg        Leg                 @relation(fields: [legId], references: [id])
  driverId   Int                 @map("driver_id")
  driver     Driver              @relation(fields: [driverId], references: [id])
  status     DispatchOfferStatus @default(PENDING)
  // 送出当下的距离快照（Ranking Engine 算好的），单纯给 Dispatcher board 显示用，不影响
  // Accept/Decline 的判断逻辑。没有坐标时是 null。
  distanceKm Float?              @map("distance_km")
  offeredAt   DateTime  @default(now()) @map("offered_at")
  respondedAt DateTime? @map("responded_at")
  expiresAt   DateTime  @map("expires_at")

  @@index([legId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("dispatch_offers")
}

// Module 9（Financial Model v2）：Booking Charge 的分类参考资料表，决定 Revenue Rule。
// 新增分类是纯资料操作，不需要改业务逻辑代码——跟 Role（Module 7）、CompanySettings
// （Module 8）是同一种设计哲学。见 docs/design/financial-model-v2.md 第 4 章。
model ChargeType {
  id    Int    @id @default(autoincrement())
  key   String @unique
  label String

  // true 时这笔 Charge 按 Booking 的 Commission % 拆 Platform/Driver 两份，
  // isCompanyRevenue 在这个情况下不生效（已经是拆分的，不是二选一）。
  participatesInRevenueSharing Boolean @default(false) @map("participates_in_revenue_sharing")
  // 只有 participatesInRevenueSharing = false 时才有意义：true 全部算 Company Revenue，
  // false 全部算 Driver Passthrough。
  isCompanyRevenue             Boolean @default(false) @map("is_company_revenue")

  // 停用用这个栏位，不做物理删除——停用不影响历史 Charge 引用这个分类。
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  charges BookingCharge[]

  @@index([active])
  @@map("charge_types")
}

// 客户应该支付的每一笔费用，独立 Ledger，Append Only——没有 UPDATE/DELETE，
// 更正一律新增新记录：补收用 adjustmentType=ADDITION，冲销用 REVERSAL，
// adjustsChargeId 指回原始 Charge。Booking.totalAmountCents = SUM(amountCents)。
model BookingCharge {
  id Int @id @default(autoincrement())

  bookingId Int     @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  legId     Int?    @map("leg_id")
  leg       Leg?    @relation(fields: [legId], references: [id], onDelete: SetNull)

  chargeTypeId Int        @map("charge_type_id")
  chargeType   ChargeType @relation(fields: [chargeTypeId], references: [id], onDelete: Restrict)

  amountCents Int     @map("amount_cents")
  description String?

  // 只有 chargeType.participatesInRevenueSharing = true 的 Charge 才需要填；建立时从
  // Booking 当下的默认值 snapshot 一份，允许单独覆盖，之后不会因为 Booking 的默认值
  // 改变而跟着变（Financial Principle：Snapshot，见 financial-model-v2.md 第 2 章）。
  commissionType  CommissionType? @map("commission_type")
  commissionValue Int?            @map("commission_value")

  // adjustmentType=NONE 时 adjustsChargeId 必须是 null；ADDITION/REVERSAL 时必须指向原始
  // Charge——这个搭配关系由 migration.sql 里的 CHECK constraint 在 DB 层保证。
  adjustmentType   ChargeAdjustmentType @default(NONE) @map("adjustment_type")
  adjustsChargeId  Int?                 @map("adjusts_charge_id")
  adjustsCharge    BookingCharge?       @relation("BookingChargeAdjustments", fields: [adjustsChargeId], references: [id], onDelete: Restrict)
  adjustments      BookingCharge[]      @relation("BookingChargeAdjustments")
  adjustmentReason String?              @map("adjustment_reason")

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("BookingChargeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  collections        Collection[]
  walletTransactions WalletTransaction[]

  @@index([bookingId])
  @@index([legId])
  @@index([chargeTypeId])
  @@index([adjustsChargeId])
  @@index([chargeTypeId, createdAt])
  @@map("booking_charges")
}

// 行程中公司或司机的实际支出（过路费/停车费/油钱…），独立 Ledger，Append Only，
// 完全不影响客户应付金额，也不参与 Revenue Sharing。更正用 reversesExpenseId
// （Void 后重建），跟 BookingCharge 的 Adjustment 机制不同——Expense 没有「补收」的概念。
model TripExpense {
  id Int @id @default(autoincrement())

  bookingId Int     @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  legId     Int?    @map("leg_id")
  leg       Leg?    @relation(fields: [legId], references: [id], onDelete: SetNull)

  expenseType           TripExpenseType   @map("expense_type")
  amountCents           Int               @map("amount_cents")
  paidBy                TripExpensePaidBy @map("paid_by")
  // 只在 paidBy=DRIVER 时有意义。true 时会走 Driver Reimbursement，产生一笔
  // EXPENSE_REIMBURSEMENT 的 WalletTransaction。
  reimbursementRequired Boolean           @default(false) @map("reimbursement_required")
  proofImageUrl         String?           @map("proof_image_url")
  description           String?
  status                TripExpenseStatus @default(PENDING)

  reversesExpenseId Int?          @map("reverses_expense_id")
  reversesExpense   TripExpense?  @relation("TripExpenseReversal", fields: [reversesExpenseId], references: [id], onDelete: Restrict)
  reversedBy        TripExpense[] @relation("TripExpenseReversal")

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("TripExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  verifiedAt     DateTime? @map("verified_at")
  verifiedBy     Int?      @map("verified_by")
  verifiedByUser User?     @relation("TripExpenseVerifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict)

  rejectedAt      DateTime? @map("rejected_at")
  rejectedBy      Int?      @map("rejected_by")
  rejectedByUser  User?     @relation("TripExpenseRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict)
  rejectionReason String?   @map("rejection_reason")

  voidedAt     DateTime? @map("voided_at")
  voidedBy     Int?      @map("voided_by")
  voidedByUser User?     @relation("TripExpenseVoidedBy", fields: [voidedBy], references: [id], onDelete: Restrict)
  voidReason   String?   @map("void_reason")

  walletTransaction WalletTransaction?

  @@unique([reversesExpenseId])
  @@index([bookingId])
  @@index([legId])
  @@index([status])
  @@index([paidBy, reimbursementRequired])
  @@map("trip_expenses")
}

// Booking 进入 FINALIZED 财务状态时产生的唯一一笔快照，锁定当下算出来的 Company Revenue /
// Driver Pool，供报表/审计使用，永不重算、永不覆写——没有 UPDATE 路径，bookingId 唯一约束
// 保证每张 Booking 最多一笔。见 financial-model-v2.md 第 7 章 Revenue Sharing Snapshot 机制。
model RevenueSharingSnapshot {
  id Int @id @default(autoincrement())

  bookingId Int     @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  triggeredBy               RevenueSnapshotTrigger @map("triggered_by")
  companyRevenueCents       Int                    @map("company_revenue_cents")
  // Module 11 起新增：Dispatcher Commission 独立于 Company Revenue 之外单独记录一份，
  // 方便以后要单独结算给 Dispatcher 时可以直接追溯，不用从 chargeBreakdown 反推。
  dispatcherCommissionCents Int                    @default(0) @map("dispatcher_commission_cents")
  driverPoolCents           Int                    @map("driver_pool_cents")
  // 当下参与计算的 Charge 明细快照（哪些 Charge、各自的分类跟金额）+ 套用的 Revenue Rule
  // 明细，供审计用。
  chargeBreakdown           Json                   @map("charge_breakdown")

  createdAt DateTime @default(now()) @map("created_at")

  walletTransactions WalletTransaction[]

  @@map("revenue_sharing_snapshots")
}

// 唯一的记账来源，只能新增、不能修改历史金额。要更正就新增一笔反向 Adjustment。
model WalletTransaction {
  id       Int    @id @default(autoincrement())
  driverId Int    @map("driver_id")
  driver   Driver @relation(fields: [driverId], references: [id])

  bookingId Int?     @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id])
  legId     Int?     @map("leg_id")
  leg       Leg?     @relation(fields: [legId], references: [id])

  transactionType WalletTransactionType   @map("transaction_type")
  // 钱的源头分类，独立于 transactionType 之外，给 Money Reference Trace 用
  // （financial-model-v2.md 第 12 章）。LEG_EARNING→BOOKING_REVENUE、
  // MANUAL_ADJUSTMENT→MANUAL、SETTLEMENT_ADJUSTMENT→SETTLEMENT_CORRECTION、
  // EXPENSE_REIMBURSEMENT→TRIP_EXPENSE，一一对应。
  source          WalletTransactionSource @map("source")
  amountCents     Int                     @map("amount_cents")
  description     String?
  status          WalletTransactionStatus @default(PENDING)
  effectiveDate   DateTime                @map("effective_date") @db.Date

  // 只有 source=TRIP_EXPENSE 会用到：这笔报销交易对应哪一笔 TripExpense，@unique 防止
  // 同一笔 Expense 被报销两次。
  tripExpenseId Int?         @unique @map("trip_expense_id")
  tripExpense   TripExpense? @relation(fields: [tripExpenseId], references: [id], onDelete: Restrict)

  // 追溯用（可选）：这笔交易是因为哪一笔特定的 BookingCharge（通常是 FINALIZED 后的
  // Adjustment）而直接产生的。一般 Leg 完成产生的 LEG_EARNING 是从整个 Driver Pool
  // 聚合分配而来，不对应单一 Charge，这个栏位留空，只靠既有的 legId 参照。
  bookingChargeId Int?           @map("booking_charge_id")
  bookingCharge   BookingCharge? @relation(fields: [bookingChargeId], references: [id], onDelete: SetNull)

  // 只有 transactionType=REVENUE_SHARE_PAYOUT 会用到（Module 12，Financial V2 专用）：
  // 这笔分润来自哪一笔 Revenue Sharing Snapshot。Snapshot 本身是 Append Only，这里只是
  // 单向参照，不会有任何代码回头去改 Snapshot。
  revenueSnapshotId Int?                    @map("revenue_snapshot_id")
  revenueSnapshot   RevenueSharingSnapshot? @relation(fields: [revenueSnapshotId], references: [id], onDelete: Restrict)

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("WalletTransactionCreatedBy", fields: [createdBy], references: [id])

  settledAt    DateTime?   @map("settled_at")
  settlementId Int?        @map("settlement_id")
  settlement   Settlement? @relation("SettlementTransactions", fields: [settlementId], references: [id])

  // 只有 SETTLEMENT_ADJUSTMENT 会用到：这笔是在更正/反冲哪一个 Settlement。
  // 跟 settlementId 不是同一件事——settlementId 是「这笔本身被哪个 Settlement 结算掉」。
  relatedSettlementId Int?        @map("related_settlement_id")
  relatedSettlement   Settlement? @relation("SettlementAdjustmentReversal", fields: [relatedSettlementId], references: [id])

  settlementItem SettlementItem?

  // 一个 Leg 一辈子只能有一笔有效的 LEG_EARNING，DB 层杜绝重复记账。
  @@unique([legId, transactionType])
  @@index([source])
  @@index([bookingChargeId])
  @@index([revenueSnapshotId])
  @@map("wallet_transactions")
}

// 不可变的日结纪录。Completed 后金额不可再改，要更正另开 Adjustment 或走 Void 流程。
model Settlement {
  id          Int              @id @default(autoincrement())
  reference   String           @unique
  driverId    Int              @map("driver_id")
  driver      Driver           @relation(fields: [driverId], references: [id])
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date
  status      SettlementStatus @default(DRAFT)

  // netAmountCents = walletAmountCents - collectionAmountCents。
  // 正数代表 Company Pay Driver，负数代表 Driver Need Return Company。
  walletAmountCents     Int @default(0) @map("wallet_amount_cents")
  collectionAmountCents Int @default(0) @map("collection_amount_cents")
  netAmountCents        Int @map("net_amount_cents")

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("SettlementCreatedBy", fields: [createdBy], references: [id])

  voidedAt     DateTime? @map("voided_at")
  voidedBy     Int?      @map("voided_by")
  voidedByUser User?     @relation("SettlementVoidedBy", fields: [voidedBy], references: [id])
  voidReason   String?   @map("void_reason")

  items                SettlementItem[]
  transactions         WalletTransaction[] @relation("SettlementTransactions")
  reversalTransactions WalletTransaction[] @relation("SettlementAdjustmentReversal")
  collections          Collection[]        @relation("SettlementCollections")

  @@map("settlements")
}

// Collection Ledger：Driver/Company 暂时／直接持有的、属于公司的钱（顾客代收/代付），跟 Wallet
// （公司欠 Driver 的钱）是两本完全独立的帐，永远不会互相直接修改对方栏位。日结时两本帐才会一起
// 被算成 Net Settlement。三本 Ledger 各自回答一个问题，见 docs/design/collection-module-v1.md：
// Collection 回答「谁收了多少钱」、Wallet 回答「公司欠司机多少钱」、Settlement 回答「最后谁应该
// 给谁多少钱」。
model Collection {
  id Int @id @default(autoincrement())

  bookingId Int     @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])
  legId     Int?    @map("leg_id")
  leg       Leg?    @relation(fields: [legId], references: [id])

  // Collected By = DRIVER 时必须有 Driver（见下方 CHECK constraint，migration.sql）；
  // Collected By = COMPANY 时可以留空，也可以保留（純粹记录这笔钱归属于哪个 Driver 的哪趟
  // 行程，方便对账），但不构成该 Driver 的 Settlement 负债——那笔过滤逻辑留给 Settlement
  // Module 处理，这次 Schema 阶段不动 Settlement 查询。onDelete 明确写成 Restrict（不是
  // Prisma 对 optional 关联的默认值 SetNull）：跟 WalletTransaction/TripExpense 这两本
  // 姊妹 Ledger 的 driver 关联行为保持一致——只要 Driver 还有 Collection 记录（不管
  // driverId 是不是唯一意义上的负债主体），就不能被物理删除，financial ledger 的可追溯性
  // 优先于「可以删除」的方便性。
  driverId Int?    @map("driver_id")
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: Restrict)

  // 谁的角色收的钱，跟 paymentMethod（怎么付）是刻意分开的两个独立维度，不合并成
  // TRANSFER_TO_DRIVER/TRANSFER_TO_COMPANY 这种揉在一起的写法（见 collection-module-v1.md 第 7 章）。
  // 沿用既有资料的既有流程全部是 Driver 代收，所以给 DRIVER 默认值，现有 create 呼叫不用改。
  collectedBy CollectedBy @default(DRIVER) @map("collected_by")

  // Receiver：Collected By 底下更精确的收款主体（collection-module-v1.md 第 8.3 节）。
  // receiverType=DRIVER 时 receiverId 就是 driverId（同一个实体，不是新概念）；
  // receiverType=COMPANY 时目前没有结构化的「公司收款账户」资料表，receiverId 先留空，
  // receiverLabel 存自由文本（例如 "Company Account A"）——是否要做成结构化清单是尚未
  // 决定的业务规则（collection-module-v1.md 第 12 章问题 1），这次只先把栏位留出来。
  // 这两个栏位目前没有 API 会写入（现有 Collection API 没有改动，见本次 Migration 的
  // 已知限制），只是 Schema 先备妥，实际赋值留给下一阶段的 Collection API。receiverType
  // 跟 collectedBy 一样给 DRIVER 默认值——v1 两者一一对应（DB CHECK constraint 保证），
  // 分成两个栏位纯粹是为了未来两者有可能分歧时不需要再动一次 Schema。
  receiverType  CollectionReceiverType @default(DRIVER) @map("receiver_type")
  receiverId    Int?                   @map("receiver_id")
  receiverLabel String?                @map("receiver_label")

  customerName  String?                 @map("customer_name")
  purpose       CollectionPurpose
  amountCents   Int                     @map("amount_cents")
  paymentMethod CollectionPaymentMethod @map("payment_method")
  status        CollectionStatus        @default(PENDING)

  // 单向、可选：这笔实收对应哪一笔应收费用，纯核对标注，不做金额一致性校验，
  // BookingCharge 完全不知道 Collection 存在（见 financial-model-v2.md 第 6 章）。
  relatedChargeId Int?           @map("related_charge_id")
  relatedCharge   BookingCharge? @relation(fields: [relatedChargeId], references: [id], onDelete: SetNull)

  // Partial Collection（分次收款）：第一笔（parentCollectionId=null）带 expectedAmountCents
  // 当作这一组的应收总额；之后每一次实际收到钱都是新增一笔独立记录，parentCollectionId
  // 指回第一笔。Received/Outstanding 都是衍生计算，不存 DB（见 financial-model-v2.md 第 6 章）。
  // 「同一组子记录 collectedAmount 总额不能超过 expectedAmount」是跨行加总规则，Postgres
  // CHECK constraint 做不到跨行验证，这次 Schema 阶段不做 Trigger，留给 API 阶段做 Service
  // 层验证（跟专案其他业务规则一致的做法，例如 Revenue Sharing/BookingCharge 都是 Service
  // 层验证，不是 DB Trigger）。
  expectedAmountCents Int?         @map("expected_amount_cents")
  parentCollectionId  Int?         @map("parent_collection_id")
  parentCollection    Collection?  @relation("CollectionPartialPayments", fields: [parentCollectionId], references: [id], onDelete: Restrict)
  partialPayments     Collection[] @relation("CollectionPartialPayments")

  collectedAt DateTime? @map("collected_at")

  remark        String?
  proofImageUrl String? @map("proof_image_url")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("CollectionCreatedBy", fields: [createdBy], references: [id])

  verifiedAt     DateTime? @map("verified_at")
  verifiedBy     Int?      @map("verified_by")
  verifiedByUser User?     @relation("CollectionVerifiedBy", fields: [verifiedBy], references: [id])

  voidedAt     DateTime? @map("voided_at")
  voidedBy     Int?      @map("voided_by")
  voidedByUser User?     @relation("CollectionVoidedBy", fields: [voidedBy], references: [id])
  voidReason   String?   @map("void_reason")

  settledAt    DateTime?   @map("settled_at")
  settlementId Int?        @map("settlement_id")
  settlement   Settlement? @relation("SettlementCollections", fields: [settlementId], references: [id])

  @@index([relatedChargeId])
  @@index([parentCollectionId])
  @@index([driverId, status, collectedAt])
  @@index([bookingId])
  @@index([status])
  @@index([collectedBy])
  @@index([receiverType, receiverId])
  @@map("collections")
}

// 记录一笔 Settlement 包含哪些 Wallet Transaction。walletTransactionId 加 @unique，
// 保证同一笔 Transaction 不会同时出现在两个 Settlement 里。
model SettlementItem {
  id                  Int               @id @default(autoincrement())
  settlementId        Int               @map("settlement_id")
  settlement          Settlement        @relation(fields: [settlementId], references: [id])
  walletTransactionId Int               @unique @map("wallet_transaction_id")
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id])
  amountCents         Int               @map("amount_cents")
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("settlement_items")
}

// 所有重要操作（帐号、司机资料、Leg 状态变更、Commission/Allocation、Wallet、Settlement）都写一笔，
// 方便追查是谁在什么时候做了什么。beforeData/afterData 用在真的有「改动前后」的操作；
// 单纯的建立事件（例如 LEG_EARNING_CREATED）只会有 afterData。metadata 放其他辅助资讯（原因、关联 id 等）。
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  // 存 Role.key 的字串快照（不是外键），理由跟 RolePermission.permissionKey 一样：
  // 以后新增角色是纯资料操作，不应该反过来又要求这里做一次 schema migration。
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    Int      @map("entity_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
