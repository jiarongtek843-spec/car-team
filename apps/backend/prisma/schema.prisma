generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Leg 的完整状态机，见 docs/modules/driver-account.md
enum LegStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  DRIVER_ARRIVING
  PASSENGER_ON_BOARD
  COMPLETED
  REJECTED
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WalletTransactionType {
  LEG_EARNING
  MANUAL_ADJUSTMENT
  SETTLEMENT_ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  SETTLED
  VOIDED
}

enum SettlementStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum CollectionPaymentMethod {
  CASH
  TRANSFER_TO_DRIVER
  TRANSFER_TO_COMPANY
  TNG
  OTHER
}

enum CollectionPurpose {
  ITEM_PURCHASE
  DELIVERY_FEE
  PARCEL
  EXTRA_CHARGE
  PARKING
  TOLL
  OTHER
}

// Collection 是独立于 Wallet 的第二本 Ledger：代表 Driver 暂时替公司保管的钱
// (公司应收，不是 Driver 收入)。PENDING 保留给未来「Admin 指派代收任务」的流程，
// 目前 Driver 新增时直接是 COLLECTED（代表钱已经实际收到手上）。
enum CollectionStatus {
  PENDING
  COLLECTED
  VERIFIED
  SETTLED
  VOIDED
}

// RBAC（Module 7）：Role 存数据库，Permission Key 固定写在
// apps/backend/src/common/permissions.ts。以后新增角色（例如 Finance）只需要新增一笔
// Role 资料 + 对应的 RolePermission，不需要改任何业务逻辑代码——业务 service/controller
// 从来不会判断 role，权限检查完全集中在 requirePermission middleware 这一层。
model Role {
  id          Int      @id @default(autoincrement())
  // 机器可读、稳定不变的代号，程式码里用这个比对（例如判断是不是 Driver 角色）。
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// permissionKey 不是外键，对应的是 permissions.ts 里 PERMISSIONS 常数定义的字串
// （例如 "wallet:write"）——Permission 本身不是一个需要在 DB 里维护的实体，只有
// 「哪个角色拥有哪些 Permission」这个对应关系是资料。
model RolePermission {
  id            Int      @id @default(autoincrement())
  roleId        Int      @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

// 登入帐号，四种角色共用同一套。Driver 角色的业务资料在 Driver model，
// 两者用 userId 关联；非 Driver 角色没有对应的 Driver row。
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  driver       Driver?
  auditLogs    AuditLog[]

  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  settlementsCreated        Settlement[]        @relation("SettlementCreatedBy")
  settlementsVoided         Settlement[]        @relation("SettlementVoidedBy")

  collectionsCreated  Collection[] @relation("CollectionCreatedBy")
  collectionsVerified Collection[] @relation("CollectionVerifiedBy")
  collectionsVoided   Collection[] @relation("CollectionVoidedBy")

  @@map("users")
}

// 司机业务资料。userId 关联登入帐号；status 同时也是「是否停用」的唯一依据
// （沿用 Module 1 就有的栏位，没有另外加一个重复的启用/停用状态）。
model Driver {
  id                 Int          @id @default(autoincrement())
  userId             Int?         @unique @map("user_id")
  user               User?        @relation(fields: [userId], references: [id])
  name               String
  phone              String?
  vehiclePlateNumber String?      @map("vehicle_plate_number")
  remark             String?
  status             DriverStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  legs               Leg[]

  walletTransactions WalletTransaction[]
  settlements        Settlement[]
  collections        Collection[]

  // GPS 上线状态。isOnline 是 Driver 自己按 Go Online/Go Offline 设的旗标；实际显示给 Admin 的
  // presence（是否 Connection Lost / 自动 Offline）由 gps.service.ts 依据 DriverLocation 的
  // 最后上传时间即时算出，不是只看这个栏位——见 docs/modules/gps.md。
  isOnline     Boolean         @default(false) @map("is_online")
  onlineSince  DateTime?       @map("online_since")
  location     DriverLocation?

  @@map("drivers")
}

// 只存「最新一笔」定位，不做轨迹历史（第一版明确不需要轨迹回放）。每次上传直接覆盖。
// recordedAt 是装置端上报的时间，receivedAt 是 Backend 收到的时间——heartbeat/自动离线判断
// 一律用 receivedAt，避免装置时间不准影响判断。
model DriverLocation {
  driverId       Int      @id @map("driver_id")
  driver         Driver   @relation(fields: [driverId], references: [id])
  latitude       Float
  longitude      Float
  speed          Float?
  heading        Float?
  batteryPercent Int?     @map("battery_percent")
  recordedAt     DateTime @map("recorded_at")
  receivedAt     DateTime @updatedAt @map("received_at")

  @@map("driver_locations")
}

// 单例设定表，只会有一笔（id=1）。Module 8 起，所有系统模块的可调参数（GPS 阈值、
// Collection 上传大小上限、Booking 默认抽成…）统一从这里读，不要把数值写死在程式码里。
model CompanySettings {
  id Int @id @default(autoincrement())

  // General
  companyName String @default("") @map("company_name")
  timezone    String @default("Asia/Kuala_Lumpur") @map("timezone")
  currency    String @default("RM") @map("currency")

  // Booking（defaultCommissionType/Value 是 Module 3 就有的既有栏位，Booking 建立时读这里当默认抽成）
  defaultCommissionType    CommissionType @default(PERCENTAGE) @map("default_commission_type")
  // PERCENTAGE 时是整数百分比（15 = 15%）；FIXED_AMOUNT 时是 cents。
  defaultCommissionValue   Int            @default(15) @map("default_commission_value")
  // 目前只存资料、不影响实际行为（业务逻辑本来就一直是「允许手动分配」/「一定要 Driver Accept」），
  // 保留给未来真的要做成可切换行为时使用，见 docs/modules/company-settings.md 已知限制。
  allowManualLegAllocation Boolean        @default(true) @map("allow_manual_leg_allocation")
  requireDriverAccept      Boolean        @default(true) @map("require_driver_accept")

  // GPS（gps.service.ts 的 presence 阈值、前端上传间隔，全部从这里读，不再写死常数）
  gpsUploadIntervalSeconds     Int @default(5) @map("gps_upload_interval_seconds")
  connectionLostTimeoutSeconds Int @default(30) @map("connection_lost_timeout_seconds")
  offlineTimeoutSeconds        Int @default(120) @map("offline_timeout_seconds")

  // Settlement（目前没有任何排程会真的用到这两个栏位——现在的 Daily Settlement 是手动触发，
  // 这两个栏位是给未来「自动排程结算」预留的设定，见已知限制）
  defaultSettlementTime String @default("21:00") @map("default_settlement_time")
  settlementTimezone    String @default("Asia/Kuala_Lumpur") @map("settlement_timezone")

  // Collection（maxUploadFileSizeMb 真的会拿去限制上传大小；collectionVerificationRequired
  // 目前只存资料，业务逻辑本来就一直要求 Verified 才能结算，见已知限制）
  collectionVerificationRequired Boolean @default(true) @map("collection_verification_required")
  maxUploadFileSizeMb            Int     @default(5) @map("max_upload_file_size_mb")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model Booking {
  id       Int     @id @default(autoincrement())
  girlName String  @map("girl_name")
  notes    String?

  // Booking 总价与抽成。建立时从 CompanySettings 复制默认值，之后可单独覆盖这张 Booking，
  // 不影响全公司设定。platformAmountCents / driverPoolAmountCents 一律由 Backend 算出，
  // 不接受前端直接传入。
  totalAmountCents        Int            @default(0) @map("total_amount_cents")
  platformCommissionType  CommissionType @default(PERCENTAGE) @map("platform_commission_type")
  platformCommissionValue Int            @default(15) @map("platform_commission_value")
  platformAmountCents     Int            @default(0) @map("platform_amount_cents")
  driverPoolAmountCents   Int            @default(0) @map("driver_pool_amount_cents")

  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  legs      Leg[]

  walletTransactions WalletTransaction[]
  collections        Collection[]

  @@map("bookings")
}

model Leg {
  id              Int       @id @default(autoincrement())
  bookingId       Int       @map("booking_id")
  booking         Booking   @relation(fields: [bookingId], references: [id])
  sequence        Int
  driverId        Int?      @map("driver_id")
  driver          Driver?   @relation(fields: [driverId], references: [id])
  pickupLocation  String?   @map("pickup_location")
  dropoffLocation String?   @map("dropoff_location")
  scheduledAt     DateTime? @map("scheduled_at")
  notes           String?
  status          LegStatus @default(PENDING)

  // 这个 Leg 完成后司机应得多少钱。Admin 设定，Completed 后不可再改。
  earningAllocationCents Int? @map("earning_allocation_cents")

  rejectionReason    String?   @map("rejection_reason")
  assignedAt         DateTime? @map("assigned_at")
  acceptedAt         DateTime? @map("accepted_at")
  driverArrivingAt   DateTime? @map("driver_arriving_at")
  passengerOnBoardAt DateTime? @map("passenger_on_board_at")
  completedAt        DateTime? @map("completed_at")
  rejectedAt         DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  walletTransactions WalletTransaction[]
  collections        Collection[]

  @@unique([bookingId, sequence])
  @@map("legs")
}

// 唯一的记账来源，只能新增、不能修改历史金额。要更正就新增一笔反向 Adjustment。
model WalletTransaction {
  id     Int    @id @default(autoincrement())
  driverId Int  @map("driver_id")
  driver   Driver @relation(fields: [driverId], references: [id])

  bookingId Int?     @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id])
  legId     Int?     @map("leg_id")
  leg       Leg?     @relation(fields: [legId], references: [id])

  transactionType WalletTransactionType   @map("transaction_type")
  amountCents     Int                     @map("amount_cents")
  description     String?
  status          WalletTransactionStatus @default(PENDING)
  effectiveDate   DateTime                @map("effective_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  createdBy Int?     @map("created_by")
  createdByUser User? @relation("WalletTransactionCreatedBy", fields: [createdBy], references: [id])

  settledAt    DateTime?   @map("settled_at")
  settlementId Int?        @map("settlement_id")
  settlement   Settlement? @relation("SettlementTransactions", fields: [settlementId], references: [id])

  // 只有 SETTLEMENT_ADJUSTMENT 会用到：这笔是在更正/反冲哪一个 Settlement。
  // 跟 settlementId 不是同一件事——settlementId 是「这笔本身被哪个 Settlement 结算掉」。
  relatedSettlementId Int?        @map("related_settlement_id")
  relatedSettlement   Settlement? @relation("SettlementAdjustmentReversal", fields: [relatedSettlementId], references: [id])

  settlementItem SettlementItem?

  // 一个 Leg 一辈子只能有一笔有效的 LEG_EARNING，DB 层杜绝重复记账。
  @@unique([legId, transactionType])
  @@map("wallet_transactions")
}

// 不可变的日结纪录。Completed 后金额不可再改，要更正另开 Adjustment 或走 Void 流程。
model Settlement {
  id             Int              @id @default(autoincrement())
  reference      String           @unique
  driverId       Int              @map("driver_id")
  driver         Driver           @relation(fields: [driverId], references: [id])
  periodStart    DateTime         @map("period_start") @db.Date
  periodEnd      DateTime         @map("period_end") @db.Date
  status         SettlementStatus @default(DRAFT)

  // netAmountCents = walletAmountCents - collectionAmountCents。
  // 正数代表 Company Pay Driver，负数代表 Driver Need Return Company。
  walletAmountCents     Int @default(0) @map("wallet_amount_cents")
  collectionAmountCents Int @default(0) @map("collection_amount_cents")
  netAmountCents        Int @map("net_amount_cents")

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("SettlementCreatedBy", fields: [createdBy], references: [id])

  voidedAt   DateTime? @map("voided_at")
  voidedBy   Int?      @map("voided_by")
  voidedByUser User?   @relation("SettlementVoidedBy", fields: [voidedBy], references: [id])
  voidReason String?   @map("void_reason")

  items                SettlementItem[]
  transactions         WalletTransaction[] @relation("SettlementTransactions")
  reversalTransactions WalletTransaction[] @relation("SettlementAdjustmentReversal")
  collections          Collection[]        @relation("SettlementCollections")

  @@map("settlements")
}

// Collection Ledger：Driver 暂时替公司保管的钱（顾客代收/代付），跟 Wallet（公司欠 Driver 的钱）
// 是两本完全独立的帐，永远不会互相直接修改对方栏位。日结时两本帐才会一起被算成 Net Settlement。
model Collection {
  id Int @id @default(autoincrement())

  bookingId Int     @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])
  legId     Int?    @map("leg_id")
  leg       Leg?    @relation(fields: [legId], references: [id])
  driverId  Int     @map("driver_id")
  driver    Driver  @relation(fields: [driverId], references: [id])

  customerName  String?                 @map("customer_name")
  purpose       CollectionPurpose
  amountCents   Int                     @map("amount_cents")
  paymentMethod CollectionPaymentMethod @map("payment_method")
  status        CollectionStatus        @default(PENDING)

  collectedAt DateTime? @map("collected_at")

  remark        String?
  proofImageUrl String? @map("proof_image_url")

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     Int?     @map("created_by")
  createdByUser User?    @relation("CollectionCreatedBy", fields: [createdBy], references: [id])

  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      Int?      @map("verified_by")
  verifiedByUser  User?     @relation("CollectionVerifiedBy", fields: [verifiedBy], references: [id])

  voidedAt   DateTime? @map("voided_at")
  voidedBy   Int?      @map("voided_by")
  voidedByUser User?   @relation("CollectionVoidedBy", fields: [voidedBy], references: [id])
  voidReason String?   @map("void_reason")

  settledAt    DateTime?   @map("settled_at")
  settlementId Int?        @map("settlement_id")
  settlement   Settlement? @relation("SettlementCollections", fields: [settlementId], references: [id])

  @@map("collections")
}

// 记录一笔 Settlement 包含哪些 Wallet Transaction。walletTransactionId 加 @unique，
// 保证同一笔 Transaction 不会同时出现在两个 Settlement 里。
model SettlementItem {
  id                  Int      @id @default(autoincrement())
  settlementId        Int      @map("settlement_id")
  settlement          Settlement @relation(fields: [settlementId], references: [id])
  walletTransactionId Int      @unique @map("wallet_transaction_id")
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id])
  amountCents         Int      @map("amount_cents")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("settlement_items")
}

// 所有重要操作（帐号、司机资料、Leg 状态变更、Commission/Allocation、Wallet、Settlement）都写一笔，
// 方便追查是谁在什么时候做了什么。beforeData/afterData 用在真的有「改动前后」的操作；
// 单纯的建立事件（例如 LEG_EARNING_CREATED）只会有 afterData。metadata 放其他辅助资讯（原因、关联 id 等）。
model AuditLog {
  id          Int       @id @default(autoincrement())
  actorUserId Int?      @map("actor_user_id")
  actorUser   User?     @relation(fields: [actorUserId], references: [id])
  // 存 Role.key 的字串快照（不是外键），理由跟 RolePermission.permissionKey 一样：
  // 以后新增角色是纯资料操作，不应该反过来又要求这里做一次 schema migration。
  actorRole   String?   @map("actor_role")
  action      String
  entityType  String    @map("entity_type")
  entityId    Int       @map("entity_id")
  beforeData  Json?     @map("before_data")
  afterData   Json?     @map("after_data")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}
