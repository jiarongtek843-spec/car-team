generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DRIVER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Leg 的完整状态机，见 docs/modules/driver-account.md
enum LegStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  DRIVER_ARRIVING
  PASSENGER_ON_BOARD
  COMPLETED
  REJECTED
  CANCELLED
}

// 登入帐号，Admin 和 Driver 共用同一套。Driver 的业务资料在 Driver model，
// 两者用 userId 关联；Admin 没有对应的 Driver row。
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  driver       Driver?
  auditLogs    AuditLog[]

  @@map("users")
}

// 司机业务资料。userId 关联登入帐号；status 同时也是「是否停用」的唯一依据
// （沿用 Module 1 就有的栏位，没有另外加一个重复的启用/停用状态）。
model Driver {
  id                 Int          @id @default(autoincrement())
  userId             Int?         @unique @map("user_id")
  user               User?        @relation(fields: [userId], references: [id])
  name               String
  phone              String?
  vehiclePlateNumber String?      @map("vehicle_plate_number")
  remark             String?
  status             DriverStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  legs               Leg[]

  @@map("drivers")
}

model Booking {
  id        Int           @id @default(autoincrement())
  girlName  String        @map("girl_name")
  carFee    Int?          @map("car_fee")
  notes     String?
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  legs      Leg[]

  @@map("bookings")
}

model Leg {
  id              Int       @id @default(autoincrement())
  bookingId       Int       @map("booking_id")
  booking         Booking   @relation(fields: [bookingId], references: [id])
  sequence        Int
  driverId        Int?      @map("driver_id")
  driver          Driver?   @relation(fields: [driverId], references: [id])
  pickupLocation  String?   @map("pickup_location")
  dropoffLocation String?   @map("dropoff_location")
  scheduledAt     DateTime? @map("scheduled_at")
  notes           String?
  status          LegStatus @default(PENDING)

  rejectionReason   String?   @map("rejection_reason")
  assignedAt        DateTime? @map("assigned_at")
  acceptedAt        DateTime? @map("accepted_at")
  driverArrivingAt  DateTime? @map("driver_arriving_at")
  passengerOnBoardAt DateTime? @map("passenger_on_board_at")
  completedAt       DateTime? @map("completed_at")
  rejectedAt         DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookingId, sequence])
  @@map("legs")
}

// 所有重要操作（帐号、司机资料、Leg 状态变更）都写一笔，方便追查是谁在什么时候做了什么。
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    Int      @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
